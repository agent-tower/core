{
  "name": "@agent-tower/server",
  "version": "0.6.0-beta.17",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agent-tower": "./dist/cli.js",
    "agent-tower-mcp": "./dist/mcp/index.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run --root ../..",
    "build": "pnpm run db:generate && tsc && node scripts/copy-build-assets.mjs",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@agent-tower/shared": "workspace:*",
    "@agentclientprotocol/claude-agent-acp": "0.59.0",
    "@agentclientprotocol/codex-acp": "1.10.0",
    "@agentclientprotocol/sdk": "1.2.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@prisma/client": "^5.9.1",
    "@shitiandmw/node-pty": "1.1.0-shitiandmw.2",
    "cloudflared": "^0.7.1",
    "fast-json-patch": "^3.1.1",
    "fastify": "^4.26.0",
    "pi-acp": "0.0.32",
    "pi-mcp-adapter": "2.11.0",
    "prisma": "^5.9.1",
    "simple-git": "^3.22.0",
    "smol-toml": "^1.6.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
